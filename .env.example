# Copy to .env (local, never committed) and fill in from the Firebase console.
# Names only — no real values. All VITE_ variables are bundled into the public frontend,
# so NEVER put a private key, token, password or service-account value here.

# Firebase web app configuration (public client config, protected by Security Rules + App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (public reCAPTCHA site key only; the secret key stays in the Firebase console)
VITE_APPCHECK_RECAPTCHA_SITE_KEY=

# Gemini model name used through Firebase AI Logic (a model name, not a secret).
# Verify the currently supported model at implementation time.
VITE_GEMINI_MODEL=

# NOTE: There is intentionally NO Gemini API key variable. Firebase AI Logic keeps the key
# server-side. If the Cloud Functions fallback (D-12) is approved, the key lives only in
# Firebase Secret Manager (secret name: GEMINI_API_KEY) and never in this file or the frontend.
